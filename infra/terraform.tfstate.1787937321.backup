            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"EcrAuth\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ecr:GetAuthorizationToken\",\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"EcrPush\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ecr:UploadLayerPart\",\n        \"ecr:PutImage\",\n        \"ecr:InitiateLayerUpload\",\n        \"ecr:GetDownloadUrlForLayer\",\n        \"ecr:CompleteLayerUpload\",\n        \"ecr:BatchGetImage\",\n        \"ecr:BatchCheckLayerAvailability\"\n      ],\n      \"Resource\": [\n        \"arn:aws:ecr:ap-south-1:711457211368:repository/repath/gateway\",\n        \"arn:aws:ecr:ap-south-1:711457211368:repository/repath/evaluator\",\n        \"arn:aws:ecr:ap-south-1:711457211368:repository/repath/controller\"\n      ]\n    },\n    {\n      \"Sid\": \"DeployViaSsm\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ssm:SendCommand\",\n      \"Resource\": [\n        \"arn:aws:ssm:ap-south-1:*:document/AWS-RunShellScript\",\n        \"arn:aws:ec2:ap-south-1:711457211368:instance/i-00d5424955a8f2ead\"\n      ]\n    },\n    {\n      \"Sid\": \"SsmCommandStatus\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ssm:ListCommandInvocations\",\n        \"ssm:GetCommandInvocation\"\n      ],\n      \"Resource\": \"*\"\n    }\n  ]\n}",
